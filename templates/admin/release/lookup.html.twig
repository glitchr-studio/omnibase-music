{# "Look up a record": one URL (any platform) or one UPC, and the catalogues (Omnisong) make or complete the release. #}
{% extends '@Admin/layout.html.twig' %}

{% block page_title %}{{ '@music.admin.lookup.title'|trans }}{% endblock %}

{% block content_header %}
<div class="admin-header">
    <span class="admin-header-icon"><i class="fa-solid fa-magnifying-glass"></i></span>
    <div class="admin-header-titles">
        <h1>{{ '@music.admin.lookup.title'|trans }}</h1>
        <div class="admin-header-subtitle">{{ '@music.admin.lookup.lead'|trans }}</div>
    </div>
</div>
{% endblock %}

{% block content %}
<style>
    .music-lookup { display: grid; gap: 1rem; max-width: 44rem; }
    .music-lookup form { display: grid; gap: .9rem; padding: 1rem 1.25rem; }
    .music-lookup label { display: grid; gap: .3rem; font-weight: 600; }
    .music-lookup ul { margin: 0; padding-left: 1.2rem; opacity: .8; font-size: .9rem; }
</style>
<div class="music-lookup">
    {% if not available %}<div class="alert alert-warning">{{ '@music.admin.lookup.unavailable'|trans }}</div>{% endif %}
    <form method="post" class="card">
        <input type="hidden" name="_token" value="{{ csrf_token(admin_action_token_id('lookup')) }}">
        <label>{{ '@music.admin.lookup.reference'|trans }}
            <input class="form-control" name="reference" value="{{ reference }}" required autofocus placeholder="https://music.apple.com/de/album/… · 4260085533930">
        </label>
        <ul>
            <li>{{ '@music.admin.lookup.hint_url'|trans }}</li>
            <li>{{ '@music.admin.lookup.hint_upc'|trans }}</li>
            <li>{{ '@music.admin.lookup.hint_never'|trans }}</li>
        </ul>
        <div><button class="btn btn-primary" type="submit"{{ not available ? ' disabled' }}><i class="fa-solid fa-wand-magic-sparkles"></i> {{ '@music.admin.lookup.submit'|trans }}</button></div>
    </form>
</div>
{% endblock %}
