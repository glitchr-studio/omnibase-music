{#
 # A release's player (music_player(release)): "listen in full" on the
 # platforms first - a logged-in listener's play there counts for the
 # musician - then the tracks with their excerpts or previews; with no audio
 # at all, the release's embed behind a click. `fold`: one "listen" button,
 # the track list behind a disclosure.
 #}
<div class="music-release-player">
    {% if full %}{% include '@Music/client/_full.html.twig' with {release: release, embeds: full} only %}{% endif %}
    {% if embed and not full %}{% include '@Music/client/_embed.html.twig' with {embed: embed, release: release} only %}{% endif %}
    {% if release.tracks|length and fold|default(false) %}
    {# Several records on a page: one button plays the record from its first track, the tracks wait behind a disclosure. #}
    <div class="music-fold">
        {% if playable|default(false) %}<button type="button" class="music-button music-release-play" data-music-release-play="{{ release.slug }}" aria-pressed="false"><i class="fa-solid fa-play music-icon-play" aria-hidden="true"></i><i class="fa-solid fa-pause music-icon-pause" aria-hidden="true"></i><span>{{ '@music.index.listen'|trans }}</span></button>{% endif %}
        <details class="music-fold-tracks">
            <summary><span>{{ '@music.release.tracks'|trans({count: release.tracks|length}) }}</span><i class="fa-solid fa-chevron-down" aria-hidden="true"></i></summary>
            {% include '@Music/client/_tracks.html.twig' with {release: release, waves: waves} only %}
        </details>
    </div>
    {% elseif release.tracks|length %}{% include '@Music/client/_tracks.html.twig' with {release: release, waves: waves} only %}{% endif %}
</div>
